generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model Artwork {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  category    String
  imageUrl    String
  stock       Int
  dimensions  String
  createdAt   DateTime @default(now())

  orders      Order[]
}

model Order {
  id             String   @id @default(uuid())
  customerName   String
  email          String
  phone          String
  address        String
  quantity       Int
  amount         Float
  paymentStatus  String
  orderStatus    String
  createdAt      DateTime @default(now())

  artworkId      String
  artwork        Artwork @relation(fields: [artworkId], references: [id])
  shipments      Shipment[]
}

model Shipment {
  id              String    @id @default(uuid())
  orderId         String
  courierPartner  String
  trackingId      String
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  estimatedDate   DateTime?
  currentStatus   String    @default("Shipped")
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Reel {
  id          String   @id @default(uuid())
  youtubeId   String
  title       String
  description String
  category    String
  views       String   @default("0 views")
  createdAt   DateTime @default(now())
}
